  "findings": [
    {
      "owner": "AutomaticGraphics.prepare",
      "observed": "Candidate driver pool is the configured driver plus System, rather than every installed driver. Payload hashes and capability identities already invalidate remembered routes.",
      "proposed": "After qualification, include a small known-good installed driver set in the existing automatic route planner; retain explicit choices and four-attempt bound."
    },
    {
      "owner": "Container.DEFAULT_ENV_VARS",
      "observed": "TU_DEBUG=noconform,sysmem is the container default.",
      "proposed": "Measure normal Turnip mode against forced sysmem per supported GPU/game; retain required GPU workarounds."
    },
    {
      "owner": "vulkan.c probeCapabilitiesNative",
      "observed": "The feature probe creates an instance and inspects a physical device; it does not create a logical device, submit work or present via the final Wine/wrapper/translator path.",
      "proposed": "Qualify the effective driver, wrapper and translator together; treat current feature checks as a minimum filter."
    },
    {
      "owner": "DriverPackages.install",
      "observed": "The two A6xx/A7xx archives declare the same meta.name; install keys the directory by name and rejects an existing directory. minApi is trusted but understated by these archives.",
      "proposed": "Preserve distinct variant identity and explain loader incompatibility; retain existing archive bounds and Android/Linux discrimination."
    },
    {
      "owner": "Upstream patchs1 source",
      "observed": "Mesh shaders are emulated via compute and a device-wide ring; those render passes use sysmem. A separate retired-IB cache patch caps idle storage at 256 MiB, but its literal is absent from the released libraries.",
      "proposed": "Do not assume every recipe patch shipped or that feature emulation increases FPS. Rebuild from pinned inputs before making source-to-binary or memory claims."
    }
  ],
