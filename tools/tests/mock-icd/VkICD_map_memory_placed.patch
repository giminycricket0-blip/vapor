     }
 
     auto *props_12 = lvl_find_mod_in_chain<VkPhysicalDeviceVulkan12Properties>(pProperties->pNext);
@@ -4072,6 +4088,14 @@ static VKAPI_ATTR void VKAPI_CALL GetPhysicalDeviceProperties2KHR(
         std::strncpy(driver_properties->driverInfo, "Branch: --unknown-- Tag Info: --unknown--", VK_MAX_DRIVER_INFO_SIZE);
 #endif
     }
+
+    // Vapor loader-path lane: report a non-zero placed-memory map alignment so
+    // the validation layer's VK_MEMORY_MAP_PLACED_BIT_EXT alignment checks are
+    // meaningful (the stock mock leaves this property at 0).
+    auto *map_memory_placed_props = lvl_find_mod_in_chain<VkPhysicalDeviceMapMemoryPlacedPropertiesEXT>(pProperties->pNext);
+    if (map_memory_placed_props) {
+       map_memory_placed_props->minPlacedMemoryMapAlignment = 4096;
