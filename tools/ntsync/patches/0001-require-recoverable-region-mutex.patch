+#[cfg(test)]
+mod vapor_recovery_tests {
+    use super::*;
+
+    #[cfg(target_os = "android")]
+    #[test]
+    fn initialization_requires_real_robust_mutex_apis() {
+        let h = unsafe { libc::dlopen(b"libc.so\0".as_ptr().cast(), libc::RTLD_NOW) };
+        assert!(!h.is_null());
+        let missing = unsafe {
+            libc::dlsym(h, b"pthread_mutexattr_setrobust\0".as_ptr().cast()).is_null()
+                || libc::dlsym(h, b"pthread_mutex_consistent\0".as_ptr().cast()).is_null()
+        };
+        unsafe { libc::dlclose(h) };
+        let path = std::env::temp_dir().join(format!("vapor-init-{}.shm", std::process::id()));
+        let result = init(Some(path.to_str().unwrap()));
+        if missing {
+            assert_eq!(result, Err(Error::Init(libc::ENOSYS)));
+            let versioned = path.with_extension(format!("v{VERSION}.shm"));
+            assert!(!versioned.exists(), "unsupported initialization must not publish a region");
+        } else {
+            assert_eq!(result, Ok(()));
+        }
+    }
+
+    #[test]
+    fn backend_recovers_after_owner_death_or_refuses_initialization() {
+        let path = std::env::temp_dir().join(format!("vapor-owner-death-{}.shm", std::process::id()));
+        let initialized = init(Some(path.to_str().unwrap()));
+        if initialized == Err(Error::Init(libc::ENOSYS)) {
+            println!("backend unavailable: initialization refused; owner-death recovery not exercised");
+            return;
+        }
+        initialized.unwrap();
+        let r = region().unwrap();
+        let child = unsafe { libc::fork() };
+        assert!(child >= 0);
+        if child == 0 {
+            let _guard = r.lock_guard().unwrap();
+            unsafe { libc::_exit(0) };
+        }
+        let mut status = 0;
+        assert_eq!(unsafe { libc::waitpid(child, &mut status, 0) }, child);
+        assert!(libc::WIFEXITED(status) && libc::WEXITSTATUS(status) == 0);
+        let mut deadline = unsafe { std::mem::zeroed::<libc::timespec>() };
+        assert_eq!(unsafe { libc::clock_gettime(libc::CLOCK_REALTIME, &mut deadline) }, 0);
+        deadline.tv_nsec += 250_000_000;
+        if deadline.tv_nsec >= 1_000_000_000 {
+            deadline.tv_sec += 1;
+            deadline.tv_nsec -= 1_000_000_000;
+        }
+        let lock = &r.header().lock as *const libc::pthread_mutex_t as *mut _;
+        let result = unsafe { libc::pthread_mutex_timedlock(lock, &deadline) };
+        if result == libc::EOWNERDEAD {
+            assert_eq!(unsafe { pthread_mutex_consistent(lock) }, 0);
+            assert_eq!(unsafe { libc::pthread_mutex_unlock(lock) }, 0);
+        } else if result == 0 {
+            unsafe { libc::pthread_mutex_unlock(lock) };
+        }
+        assert_eq!(result, libc::EOWNERDEAD, "shared region lock did not recover after its owner process exited");
+    }
+}
