+// D2: host-mapping registry.  The host-CPU BCn path used to map the source
+// buffer memory and never unmap it, which both leaked a host mapping and mapped
+// memory the application already had mapped (VUID-vkMapMemory-memory-00678).
+// These helpers let the wrapper reuse an application mapping and only unmap the
+// mapping it created itself.
+// Caller must hold device->host_mapping_mutex.
+static wrapper_host_mapping *
+wrapper_host_mapping_find_locked(struct wrapper_device *device, VkDeviceMemory memory) {
+   list_for_each_entry(wrapper_host_mapping, mapping, &device->host_mappings, link) {
+      if (mapping->memory == memory)
+         return mapping;
+   }
+   return NULL;
+}
+
+// Caller must hold device->host_mapping_mutex.
+static void
+wrapper_host_mapping_forget_locked(struct wrapper_device *device, VkDeviceMemory memory) {
+   list_for_each_entry_safe(wrapper_host_mapping, mapping,
+                            &device->host_mappings, link) {
+      if (mapping->memory == memory) {
+         list_del(&mapping->link);
+         vk_free(&device->vk.alloc, mapping);
+      }
+   }
+}
+
+void
+wrapper_host_mapping_record(struct wrapper_device *device, VkDeviceMemory memory,
+                            VkDeviceSize offset, VkDeviceSize size, void *data) {
+   simple_mtx_lock(&device->host_mapping_mutex);
+   wrapper_host_mapping_forget_locked(device, memory);
+   wrapper_host_mapping *mapping =
+      vk_alloc(&device->vk.alloc, sizeof(*mapping), 8,
+               VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (!mapping) {
+      simple_mtx_unlock(&device->host_mapping_mutex);
+      WLOGE("Failed to track host mapping of memory %p", memory);
+      return;
+   }
+   mapping->memory = memory;
+   mapping->data = data;
+   mapping->offset = offset;
+   mapping->size = size;
+   list_addtail(&mapping->link, &device->host_mappings);
+   simple_mtx_unlock(&device->host_mapping_mutex);
+}
+
+void
+wrapper_host_mapping_forget(struct wrapper_device *device, VkDeviceMemory memory) {
+   simple_mtx_lock(&device->host_mapping_mutex);
+   wrapper_host_mapping_forget_locked(device, memory);
+   simple_mtx_unlock(&device->host_mapping_mutex);
+}
+
+bool
+wrapper_host_mapping_lookup(struct wrapper_device *device, VkDeviceMemory memory,
+                            VkDeviceSize offset, VkDeviceSize size,
+                            bool *exists, void **data) {
+   bool covered = false;
+
+   simple_mtx_lock(&device->host_mapping_mutex);
+   wrapper_host_mapping *mapping = wrapper_host_mapping_find_locked(device, memory);
+   if (exists)
+      *exists = mapping != NULL;
+   if (mapping && offset >= mapping->offset &&
+       (mapping->size == VK_WHOLE_SIZE ||
+        offset + size <= mapping->offset + mapping->size)) {
+      *data = (char *) mapping->data + (offset - mapping->offset);
+      covered = true;
+   }
+   simple_mtx_unlock(&device->host_mapping_mutex);
+
+   return covered;
 }
 
+bool
+wrapper_device_memory_mapping_exists(struct wrapper_device *device, VkDeviceMemory memory) {
+   struct wrapper_device_memory *mem = wrapper_device_memory_from_handle(device, memory);
+   return mem != NULL && mem->map_address != NULL;
+}
+
+bool
+wrapper_device_memory_lookup_mapping(struct wrapper_device *device, VkDeviceMemory memory,
+                                     VkDeviceSize offset, VkDeviceSize size, void **data) {
+   struct wrapper_device_memory *mem = wrapper_device_memory_from_handle(device, memory);
+   if (mem == NULL || mem->map_address == NULL)
+      return false;
+   if (offset + size > mem->map_size)
