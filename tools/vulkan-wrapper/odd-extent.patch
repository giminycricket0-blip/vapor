+/* Copy the in-bounds texels of a decoded 4x4 block into the destination.
+ *
+ * imageExtent is not required to be a multiple of the block size (Vulkan only
+ * forbids non-block-aligned copies for compressed formats, but the wrapper's
+ * host-CPU fallback must not assume it either).  Writing a full 4x4 block
+ * straight into the destination with a row stride of imageExtent.width texels
+ * overruns the last row and spills the partial edge columns into the following
+ * rows, corrupting in-bounds texels.  Decode blocks into this 4x4 temporary and
+ * copy only the texels that fall inside the region. */
+static void copy_block_texels(void *mappedDst, int image_stride,
+                              const void *block_texels, int texel_size,
+                              int x, int y, int width, int height) {
+    int copy_width = width - x < 4 ? width - x : 4;
+    int copy_height = height - y < 4 ? height - y : 4;
+
+    for (int i = 0; i < copy_height; i++) {
+        uint8_t *dst_row = (uint8_t *) mappedDst + (y + i) * image_stride
+                           + x * texel_size;
+        const uint8_t *src_row = (const uint8_t *) block_texels
+                                 + i * 4 * texel_size;
+
+        for (int b = 0; b < copy_width * texel_size; b++)
+            dst_row[b] = src_row[b];
+    }
 }
 
