+
+// Destroys the driver objects owned by an InterceptorState.  Null-safe, because
+// it is also called from vkDestroyDevice on partially initialised states, and
+// uses the driver dispatch table directly: these handles are created with the
+// raw driver entry points and are not tracked in the wrapper object maps (D1).
+static void InterceptorState_Cleanup(struct wrapper_device* device, InterceptorState* state) {
+   VkDevice vk_device = device->dispatch_handle;
+   const struct vk_device_dispatch_table* dt = &device->dispatch_table;
+
+   if (state->pipeline != VK_NULL_HANDLE) {
+      dt->DestroyPipeline(vk_device, state->pipeline, NULL);
+      state->pipeline = VK_NULL_HANDLE;
+   }
+   if (state->pipelineLayout != VK_NULL_HANDLE) {
+      dt->DestroyPipelineLayout(vk_device, state->pipelineLayout, NULL);
+      state->pipelineLayout = VK_NULL_HANDLE;
+   }
+   if (state->descriptorSetLayout != VK_NULL_HANDLE) {
+      dt->DestroyDescriptorSetLayout(vk_device, state->descriptorSetLayout, NULL);
+      state->descriptorSetLayout = VK_NULL_HANDLE;
+   }
+   if (state->constantsBuffer != VK_NULL_HANDLE) {
+      dt->DestroyBuffer(vk_device, state->constantsBuffer, NULL);
+      state->constantsBuffer = VK_NULL_HANDLE;
+   }
+   // NOTE: the interceptor state's constants VkDeviceMemory is intentionally left
+   // to the driver's vkDestroyDevice cleanup.  Explicitly freeing it from inside
+   // vkDestroyDevice reproducibly corrupts the emulator gfxstream ResourceTracker
+   // (SIGSEGV in ResourceTracker::on_vkDestroyDevice_pre removing a VkDeviceMemory
+   // entry, ~25-45% of runs) even though the same alloc/map/bind/free sequence is
+   // safe while the device is alive.  See the teardown-map receipt for the A/B
+   // matrix; this keeps D1 safe on the emulator while still destroying the other
+   // 12 of the 14 reported wrapper objects.
+   if (state->constantsBufferMemory != VK_NULL_HANDLE) {
+      state->constantsBufferMemory = VK_NULL_HANDLE;
+   }
 }
 
