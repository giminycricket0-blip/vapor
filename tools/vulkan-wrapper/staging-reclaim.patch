+/* Staging resources are owned by the command buffer that recorded the commands
+ * referencing them and are released from three completion-gated points:
+ *
+ *  - vkBeginCommandBuffer / vkResetCommandBuffer: Vulkan only allows these in
+ *    the initial state, which requires a preceding reset, and a command buffer
+ *    can only be reset once all submissions using it have completed.  The
+ *    staging resources of a command buffer that may still be submitted again
+ *    therefore never outlive the recorded commands that reference them.
+ *  - vkWaitForFences: for one-time-submit command buffers the application's own
+ *    submission fence is stored in wrapper_staging_resources::ready, so once
+ *    that fence is known to be signalled the resources are not referenced by
+ *    any pending submission any more.  A one-time-submit command buffer can
+ *    never be submitted (or recorded) again, which is what makes this early
+ *    release safe; re-submittable command buffers must not be handed to the
+ *    fence.
+ *  - vkDeviceWaitIdle: same for one-time-submit command buffers that were
+ *    submitted with a fence the application never waited on.
+ *
+ * The fence handle stored in ::ready is only dereferenced while the
+ * application's own vkWaitForFences call that named it is still on the stack,
+ * and never on the device-idle path, so a destroyed fence cannot be observed.
+ */
 
+static void
+set_staging_resources_fence(struct wrapper_command_buffer *wcb, VkFence fence)
+{
+   if (fence == VK_NULL_HANDLE ||
+       !(wcb->usage_flags & VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT))
+      return;
+
+   list_for_each_entry(struct wrapper_staging_resources, resource,
+                       &wcb->staging_resources, link_in_parent) {
+      resource->ready = fence;
+   }
+}
+
+static void
+reclaim_completed_staging_resources(struct wrapper_device *device,
+                                    bool device_idle,
+                                    uint32_t fenceCount,
+                                    const VkFence *pFences,
+                                    VkBool32 waitAll)
+{
+   list_for_each_entry(struct wrapper_command_buffer, wcb,
+                       &device->command_buffer_list, link) {
+      if (!(wcb->usage_flags & VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT) ||
+          list_is_empty(&wcb->staging_resources))
+         continue;
+
+      struct wrapper_staging_resources *resource =
+         list_first_entry(&wcb->staging_resources,
+                          struct wrapper_staging_resources, link_in_parent);
+
+      /* The submission fence is only recorded for one-time-submit command
+       * buffers that were submitted with a fence. */
+      if (resource->ready == VK_NULL_HANDLE)
+         continue;
+
+      bool completed = false;
+      if (device_idle) {
+         completed = true;
+      } else if (waitAll) {
+         for (uint32_t i = 0; i < fenceCount; i++) {
+            if (pFences[i] == resource->ready) {
+               completed = true;
+               break;
+            }
+         }
+      } else if (fenceCount == 1) {
+         /* waitAny with a single fence: VK_SUCCESS means that fence signalled. */
+         completed = pFences[0] == resource->ready;
+      } else {
+         /* waitAny over several fences: we cannot tell which one signalled. */
+         completed = false;
+      }
+
+      if (!completed)
+         continue;
+
+      if (device_idle) {
+         /* The application may already have destroyed the fence; the device
+          * being idle is sufficient, so release without touching the handle. */
+         free_staging_resources_final(device, wcb, &wcb->staging_resources);
+      } else {
+         /* Re-check the fence before releasing; resources whose fence has not
+          * signalled yet are left for a later pass. */
+         free_staging_resources_if_ready(device, wcb,
+                                         &wcb->staging_resources, false);
+      }
+   }
+}
