# IDE and local config
*.iml
.mcp.json
.vscode/
/.idea/
.DS_Store
local.properties
signing.properties
.claude/

# Gradle / Kotlin / native build output
.gradle/
.kotlin/
.tmp/
build/
app/build/
app/release/
.cxx/
app/.cxx/
.captures/
.externalNativeBuild/

# Python artifacts (tools keep their sources, see the negations below)
__pycache__/
*.pyc
*.py

# Build and log output
*.log
logcat*.txt
dist/
*.apk
*.apk.idsig
*.hprof
steam.tzst
android_sysvshm/build64/

# Generated local inputs
app/src/main/assets/proton-9.0-x86_64.txz
app/schemas/
References/
/cores/*/
/armsx2/emucore-src/
/armsx2/emucore-out/

# Signing keys and keystores
*.jks
*.keystore

# Python sources that are tracked and must never be hidden by *.py above
!app/src/main/cpp/wn-steam-launcher/steamlite-handoff/reference-scripts/*.py
!app/src/main/cpp/wn-steamapi-bridge/*.py
!tools/linuxfs/tests/*.py
!tools/sdl/*.py

# Tool and test sources that the *.py rule above would otherwise hide
!tools/tests/apk-repro-diff.py
!tools/tests/turnip-kgsl-wait.py
!tools/tests/turnip-kgsl-wait-any.py
!tools/tests/vulkan-loader-path.py
!tools/tests/vulkan-wrapper-image.py
!tools/tests/vulkan-wrapper-reference.py
!tools/tests/vulkan-wrapper-render.py
!tools/tests/vulkan-wrapper-trace.py
!tools/tests/vulkan-wrapper-validation.py
!tools/tests/wayland-fences.py
!tools/vulkan-wrapper/package-wrapper-vapor.py
!tools/check-download-urls.py

# Fixed throwaway CI debug keystore for the reproducibility lane (public test key)
!.github/ci-debug.keystore
